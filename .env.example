# Copy this file to .env and replace placeholders with local configuration.
GEMINI_API_KEY="your_gemini_api_key"

APP_URL="http://localhost:3000"

DB_HOST="127.0.0.1"
DB_PORT=3306
DB_USER="your_mysql_username"
DB_PASSWORD="your_mysql_password"
DB_NAME="plantpulse_ai"

# Generate a private random value locally; never commit your .env file.
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
